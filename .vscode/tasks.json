{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Make: Clean",
            "type": "shell",
            "command": "make clean"
        },
        {
            "label": "Make: Debug",
            "type": "shell",
            "command": "make debug",
        },
        {
            "label": "Make: Release",
            "type": "shell",
            "command": "make release"
        },
        {
            "label": "CompileDB: Generate",
            "type": "shell",
            "command": "mkdir -p .cache/clangd/ && make -Bnwk debug | pipx run compiledb -o- > .cache/clangd/compile_commands.json",
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Build: Debug",
            "group": "build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Make: Clean",
                "CompileDB: Generate",
                "Make: Debug"
            ]
        },
        {
            "label": "Build: Release",
            "group": "build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Make: Clean",
                "Make: Release"
            ]
        }
    ]
}