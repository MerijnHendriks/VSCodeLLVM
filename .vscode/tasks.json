{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Make: Clean",
            "type": "shell",
            "command": "make clean"
        },
        {
            "label": "Make: Debug",
            "type": "shell",
            "command": "make debug"
        },
        {
            "label": "Make: Release",
            "type": "shell",
            "command": "make release"
        },
        {
            "label": "Make: CompileDB",
            "type": "shell",
            "command": "make generate-compiledb",
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Build: Debug",
            "group": "build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Make: Clean",
                "Make: CompileDB",
                "Make: Debug"
            ]
        },
        {
            "label": "Build: Release",
            "group": "build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Make: Clean",
                "Make: Release"
            ]
        }
    ]
}